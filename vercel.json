{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npx prisma generate --schema=wordigo-backend/prisma/schema.prisma && cd wordigo-backend && npm install && npx prisma generate && cd ../wordigo-web && npm install",
  "buildCommand": "cd wordigo-web && npm run build",
  "outputDirectory": "wordigo-web/dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "wordigo-backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
