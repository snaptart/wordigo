{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd wordigo-backend && npm install && npx prisma generate && cd ../wordigo-web && npm install",
  "buildCommand": "cd wordigo-web && npm run build",
  "outputDirectory": "wordigo-web/dist",
  "functions": {
    "wordigo-backend/api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "wordigo-backend/src/**,wordigo-backend/prisma/**,wordigo-backend/node_modules/.prisma/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/wordigo-backend/api/index.ts"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
